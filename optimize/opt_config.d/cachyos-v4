#####
#
# MODE cachyos-v4 configuration
#
# Based on CachyOS x86-64-v4 compiler/linker flags
#
#####

CFLAGS_cachyos_v4="-march=x86-64-v4 -O3 -pipe -fno-plt -fexceptions \
-Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security \
-fstack-clash-protection -fcf-protection"

CXXFLAGS_cachyos_v4="$CFLAGS_cachyos_v4 -Wp,-D_GLIBCXX_ASSERTIONS"

LDFLAGS_cachyos_v4="-Wl,-O1 -Wl,--sort-common -Wl,--as-needed \
-Wl,-z,relro -Wl,-z,now \
-Wl,-z,pack-relative-relocs"

LTOFLAGS_cachyos_v4="-flto=auto"

OTHER_CFLAGS_cachyos_v4=$CFLAGS_cachyos_v4
OTHER_CXXFLAGS_cachyos_v4=$CXXFLAGS_cachyos_v4
OTHER_LDFLAGS_cachyos_v4=$LDFLAGS_cachyos_v4
