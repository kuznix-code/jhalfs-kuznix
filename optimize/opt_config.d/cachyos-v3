#####
#
# MODE cachyos-v3 configuration
#
# Based on CachyOS x86-64-v3 compiler/linker flags
#
# Usage: - Apply optimization string to each variable
#        - "unset" will cause the variable to be not set
#          instead of just set to null.
#
#####

CFLAGS_cachyos_v3="-march=x86-64-v3 -O3 -pipe -fno-plt -fexceptions \
-Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security \
-fstack-clash-protection -fcf-protection"

CXXFLAGS_cachyos_v3="$CFLAGS_cachyos_v3 -Wp,-D_GLIBCXX_ASSERTIONS"

LDFLAGS_cachyos_v3="-Wl,-O1 -Wl,--sort-common -Wl,--as-needed \
-Wl,-z,relro -Wl,-z,now \
-Wl,-z,pack-relative-relocs"

LTOFLAGS_cachyos_v3="-flto=auto"

OTHER_CFLAGS_cachyos_v3=$CFLAGS_cachyos_v3
OTHER_CXXFLAGS_cachyos_v3=$CXXFLAGS_cachyos_v3
OTHER_LDFLAGS_cachyos_v3=$LDFLAGS_cachyos_v3
