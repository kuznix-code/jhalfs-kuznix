#####
#
# MODE cachyos-nativecpu configuration
#
# CachyOS-style native CPU optimization
#
#####

CFLAGS_cachyos-nativecpu="-march=native -mtune=native -O3 -pipe -fno-plt -fexceptions \
-Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security \
-fstack-clash-protection -fcf-protection"

CXXFLAGS_cachyos-nativecpu="$CFLAGS_cachyos-nativecpu -Wp,-D_GLIBCXX_ASSERTIONS"

LDFLAGS_cachyos-nativecpu="-Wl,-O1 -Wl,--sort-common -Wl,--as-needed \
-Wl,-z,relro -Wl,-z,now \
-Wl,-z,pack-relative-relocs"

OTHER_CFLAGS_cachyos-nativecpu="$CFLAGS_cachyos-nativecpu"
OTHER_CXXFLAGS_cachyos-nativecpu="$CXXFLAGS_cachyos-nativecpu"
OTHER_LDFLAGS_cachyos-nativecpu="$LDFLAGS_cachyos-nativecpu"
