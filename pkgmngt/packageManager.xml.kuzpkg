<!ENTITY kuzpkg-package-format ".kuzpkg.tar.zst">

<!ENTITY libcap-version "2.78">
<!ENTITY libffi-version "3.8.0">
<!ENTITY ninja-version "1.13.2">
<!ENTITY pkgconf-version "3.0.7">
<!ENTITY meson-version "1.12.0">
