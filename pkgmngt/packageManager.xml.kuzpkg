]>

<article>

<!-- ================================================================ -->
<!-- Package downloads                                                 -->
<!-- ================================================================ -->

<sect1 id="package">
  <?dbhtml filename="package.html"?>

  <title>All Packages</title>

  <para>
    This package-management extension installs Kuzpkg
    <literal>&kuzpkg-version;</literal> into the LFS system.
    Kuzpkg uses
    <literal>&kuzpkg-package-format;</literal>
    as its native binary package format.
  </para>

  <para>
    The package manager is maintained by the Kuznix project:
    <ulink url="https://github.com/Kuznix-Team/kuzpkg"/>
  </para>

  <sect2>
    <title>Kuzpkg</title>

    <para>
      Kuzpkg <literal>&kuzpkg-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&kuzpkg-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&kuzpkg-md5;</literal>
    </para>
  </sect2>

  <sect2>
    <title>Archive support</title>

    <para>
      Libarchive <literal>&libarchive-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&libarchive-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&libarchive-md5;</literal>
    </para>
  </sect2>

  <sect2>
    <title>Network and cryptographic support</title>

    <para>
      OpenSSL <literal>&openssl-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&openssl-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&openssl-md5;</literal>
    </para>

    <para>
      Curl <literal>&curl-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&curl-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&curl-md5;</literal>
    </para>
  </sect2>

  <sect2>
    <title>Build dependencies</title>

    <para>
      libcap <literal>&libcap-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&libcap-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&libcap-md5;</literal>
    </para>

    <para>
      libffi <literal>&libffi-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&libffi-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&libffi-md5;</literal>
    </para>

    <para>
      Ninja <literal>&ninja-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&ninja-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&ninja-md5;</literal>
    </para>

    <para>
      Pkgconf <literal>&pkgconf-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&pkgconf-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&pkgconf-md5;</literal>
    </para>

    <para>
      Meson <literal>&meson-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&meson-url;"/>
    </para>

    <para>
      MD5 sum:
      <literal>&meson-md5;</literal>
    </para>

    <para>
      Fakeroot <literal>&fakeroot-version;</literal>
    </para>

    <para>
      Download:
      <ulink url="&fakeroot-url;"/>
    </para>
  </sect2>

</sect1>

<!-- ================================================================ -->
<!-- libcap                                                             -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-libcap" role="wrap">
  <?dbhtml filename="libcap.html"?>

  <sect1info condition="script">
    <productname>libcap</productname>
    <productnumber>&libcap-version;</productnumber>
    <address>&libcap-url;</address>
  </sect1info>

  <title>libcap-&libcap-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="pre">sed -i '/install -m.*STA/d' libcap/Makefile</userinput>
    </screen>

    <screen>
      <userinput remap="make">make prefix=/usr lib=lib</userinput>
    </screen>

    <screen>
      <userinput remap="install">make lib=lib prefix=/usr install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- libffi                                                              -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-libffi" role="wrap">
  <?dbhtml filename="libffi.html"?>

  <sect1info condition="script">
    <productname>libffi</productname>
    <productnumber>&libffi-version;</productnumber>
    <address>&libffi-url;</address>
  </sect1info>

  <title>libffi-&libffi-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./configure \
--prefix=/usr \
--disable-static \
--with-gcc-arch=native \
--disable-exec-static-tramp</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- OpenSSL                                                            -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-openssl" role="wrap">
  <?dbhtml filename="openssl.html"?>

  <sect1info condition="script">
    <productname>OpenSSL</productname>
    <productnumber>&openssl-version;</productnumber>
    <address>&openssl-url;</address>
  </sect1info>

  <title>OpenSSL-&openssl-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./config \
--prefix=/usr \
--openssldir=/etc/ssl \
--libdir=lib \
shared</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- libarchive                                                         -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-libarchive" role="wrap">
  <?dbhtml filename="libarchive.html"?>

  <sect1info condition="script">
    <productname>libarchive</productname>
    <productnumber>&libarchive-version;</productnumber>
    <address>&libarchive-url;</address>
  </sect1info>

  <title>libarchive-&libarchive-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./configure \
--prefix=/usr \
--disable-static \
--without-xml2</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- curl                                                               -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-curl" role="wrap">
  <?dbhtml filename="curl.html"?>

  <sect1info condition="script">
    <productname>curl</productname>
    <productnumber>&curl-version;</productnumber>
    <address>&curl-url;</address>
  </sect1info>

  <title>curl-&curl-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./configure \
--prefix=/usr \
--disable-static \
--with-openssl \
--enable-threaded-resolver \
--with-ca-path=/etc/ssl/certs</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Ninja                                                              -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-ninja" role="wrap">
  <?dbhtml filename="ninja.html"?>

  <sect1info condition="script">
    <productname>Ninja</productname>
    <productnumber>&ninja-version;</productnumber>
    <address>&ninja-url;</address>
  </sect1info>

  <title>Ninja-&ninja-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">python3 configure.py --bootstrap</userinput>
    </screen>

    <screen>
      <userinput remap="install">install -vm755 ninja /usr/bin/</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Pkgconf                                                            -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-pkgconf" role="wrap">
  <?dbhtml filename="pkgconf.html"?>

  <sect1info condition="script">
    <productname>Pkgconf</productname>
    <productnumber>&pkgconf-version;</productnumber>
    <address>&pkgconf-url;</address>
  </sect1info>

  <title>Pkgconf-&pkgconf-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./configure \
--prefix=/usr \
--disable-static</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Meson                                                              -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-meson" role="wrap">
  <?dbhtml filename="meson.html"?>

  <sect1info condition="script">
    <productname>Meson</productname>
    <productnumber>&meson-version;</productnumber>
    <address>&meson-url;</address>
  </sect1info>

  <title>Meson-&meson-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">python3 -m pip install \
--no-index \
--no-build-isolation \
--prefix=/usr \
.</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Fakeroot                                                           -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-fakeroot" role="wrap">
  <?dbhtml filename="fakeroot.html"?>

  <sect1info condition="script">
    <productname>fakeroot</productname>
    <productnumber>&fakeroot-version;</productnumber>
    <address>&fakeroot-url;</address>
  </sect1info>

  <title>Fakeroot-&fakeroot-version;</title>

  <sect2 role="installation">
    <title/>

    <screen>
      <userinput remap="configure">./configure \
--prefix=/usr</userinput>
    </screen>

    <screen>
      <userinput remap="make">make</userinput>
    </screen>

    <screen>
      <userinput remap="install">make install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Kuzpkg                                                             -->
<!-- ================================================================ -->

<sect1 id="ch-chroot-kuzpkg" role="wrap">
  <?dbhtml filename="kuzpkg.html"?>

  <sect1info condition="script">
    <productname>Kuzpkg</productname>
    <productnumber>&kuzpkg-version;</productnumber>
    <address>&kuzpkg-url;</address>
  </sect1info>

  <title>Kuzpkg-&kuzpkg-version;</title>

  <sect2 role="installation">
    <title/>

    <para>
      Kuzpkg is a pacman-derived package manager developed for the
      Kuznix project. The package archive format used by Kuzpkg is
      <literal>&kuzpkg-package-format;</literal>.
    </para>

    <screen>
      <userinput>mkdir build
cd build</userinput>
    </screen>

    <screen>
      <userinput remap="configure">meson setup \
.. \
--prefix=/usr \
--buildtype=plain \
-Dpackinstall-lfs=true \
-Dpkg-ext=.kuzpkg.tar.zst</userinput>
    </screen>

    <screen>
      <userinput remap="make">meson compile</userinput>
    </screen>

    <screen>
      <userinput remap="install">meson install</userinput>
    </screen>
  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Kuzpkg directories                                                 -->
<!-- ================================================================ -->

<sect1 id="ch-kuzpkg-creatingdirs">

  <title>Creating Kuzpkg Directories</title>

  <para>
    Create the directories used by Kuzpkg for its local database,
    package cache, package hooks, GnuPG data, and log file.
  </para>

  <screen>
    <userinput>mkdir -pv \
/var/lib/kuzpkg \
/var/cache/kuzpkg/pkg \
/etc/kuzpkg.d/hooks \
/etc/kuzpkg.d/gnupg \
/var/log</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Kuzpkg configuration                                               -->
<!-- ================================================================ -->

<sect1 id="ch-kuzpkg-config">

  <title>Configuring Kuzpkg</title>

  <screen>
    <userinput>cat &gt; /etc/kuzpkg.conf &lt;&lt; "EOF"
#
# Kuzpkg configuration
#

DBPath      = /var/lib/kuzpkg/
CacheDir    = /var/cache/kuzpkg/pkg/
LogFile     = /var/log/kuzpkg.log

SigLevel    = Never
EOF</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Kuzpkg build environment                                          -->
<!-- ================================================================ -->

<sect1 id="ch-kuzpkg-build">

  <title>Configuring the Kuzpkg Build Environment</title>

  <para>
    Kuzpkg uses the PKGBUILD-based build model inherited from pacman.
    The native package extension is
    <literal>.kuzpkg.tar.zst</literal>.
  </para>

  <screen>
    <userinput>install -d -m755 \
/var/lib/packages \
/sources</userinput>
  </screen>

  <screen>
    <userinput>cat &gt; /etc/makepkg.conf &lt;&lt; "EOF"
BUILDDIR=/sources
PKGDEST=/var/lib/packages
PACKAGER="Kuznix"
PKGEXT=".kuzpkg.tar.zst"
EOF</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Builder user                                                       -->
<!-- ================================================================ -->

<sect1 id="ch-kuzpkg-create-user">

  <title>Creating the Package Builder User</title>

  <screen>
    <userinput>if ! grep -q '^builder:' /etc/passwd; then
echo "builder:x:101:101::/home/builder:/bin/bash" &gt;&gt; /etc/passwd
echo "builder:x:101:" &gt;&gt; /etc/group
install -d -o builder -g builder /home/builder
else
install -d -o builder -g builder /home/builder
fi

chown -R builder:builder /var/lib/packages
chown builder:builder /sources</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Essential files                                                    -->
<!-- ================================================================ -->

<sect1 id="ch-kuzpkg-createfiles">

  <title>Creating Essential Kuzpkg Files</title>

  <screen>
    <userinput>install -d -m755 \
/var/lib/kuzpkg \
/var/cache/kuzpkg/pkg \
/etc/kuzpkg.d/hooks \
/etc/kuzpkg.d/gnupg \
/var/log

touch /var/log/kuzpkg.log

chmod 644 /var/log/kuzpkg.log</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Final Kuzpkg installation                                         -->
<!-- ================================================================ -->

<sect1 id="ch-system-kuzpkg" role="wrap">
  <?dbhtml filename="kuzpkg-final.html"?>

  <sect1info condition="script">
    <productname>Kuzpkg</productname>
    <productnumber>&kuzpkg-version;</productnumber>
    <address>&kuzpkg-url;</address>
  </sect1info>

  <title>Kuzpkg-&kuzpkg-version;</title>

  <sect2 role="installation">
    <title/>

    <para>
      Build and install Kuzpkg for the final LFS system.
    </para>

    <screen>
      <userinput>rm -rf build
mkdir build
cd build</userinput>
    </screen>

    <screen>
      <userinput remap="configure">meson setup \
.. \
--prefix=/usr \
--buildtype=plain \
-Dpackinstall-lfs=true \
-Dpkg-ext=.kuzpkg.tar.zst</userinput>
    </screen>

    <screen>
      <userinput remap="make">meson compile</userinput>
    </screen>

    <screen>
      <userinput remap="install">meson install</userinput>
    </screen>

  </sect2>
</sect1>

<!-- ================================================================ -->
<!-- Final directories                                                  -->
<!-- ================================================================ -->

<sect1 id="ch-system-kuzpkg-dirs">

  <title>Creating Final Kuzpkg Directories</title>

  <screen>
    <userinput>install -d -m755 \
/var/lib/kuzpkg \
/var/cache/kuzpkg/pkg \
/etc/kuzpkg.d/hooks \
/etc/kuzpkg.d/gnupg \
/var/log</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Final configuration                                                -->
<!-- ================================================================ -->

<sect1 id="ch-system-kuzpkg-config">

  <title>Installing the Final Kuzpkg Configuration</title>

  <screen>
    <userinput>cat &gt; /etc/kuzpkg.conf &lt;&lt; "EOF"
#
# Kuzpkg configuration
#

DBPath      = /var/lib/kuzpkg/
CacheDir    = /var/cache/kuzpkg/pkg/
LogFile     = /var/log/kuzpkg.log

SigLevel    = Never
EOF</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Package database                                                   -->
<!-- ================================================================ -->

<sect1 id="ch-system-kuzpkg-db">

  <title>Initial Kuzpkg Package Database</title>

  <para>
    Create the initial Kuzpkg database directory. The database is
    populated when the first package is installed.
  </para>

  <screen>
    <userinput>install -d -m755 /var/lib/kuzpkg</userinput>
  </screen>

</sect1>

<!-- ================================================================ -->
<!-- Package format                                                     -->
<!-- ================================================================ -->

<sect1 id="ch-system-kuzpkg-format">

  <title>Kuzpkg Package Format</title>

  <para>
    Kuzpkg uses the following native package archive format:
  </para>

  <screen>
    <userinput>&kuzpkg-package-format;</userinput>
  </screen>

  <para>
    Package files generated for the Kuznix LFS system therefore use
    the <literal>.kuzpkg.tar.zst</literal> suffix.
  </para>

</sect1>

</article>
