<!ENTITY ninja-url
  "https://github.com/ninja-build/ninja/archive/v1.13.2/ninja-1.13.2.tar.gz">

<!ENTITY pkgconf-url
  "https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.7.tar.xz">

<!ENTITY meson-url
  "https://github.com/mesonbuild/meson/releases/download/1.12.0/meson-1.12.0.tar.gz">

<!ENTITY openssl-url
  "https://github.com/openssl/openssl/releases/download/openssl-4.0.2/openssl-4.0.2.tar.gz">

<!ENTITY curl-url
  "https://curl.se/download/curl-8.22.0.tar.xz">

<!ENTITY libarchive-url
  "https://github.com/libarchive/libarchive/releases/download/v3.8.9/libarchive-3.8.9.tar.xz">

<!ENTITY fakeroot-url
  "https://deb.debian.org/debian/pool/main/f/fakeroot/fakeroot_2.1.4.orig.tar.xz">

<!ENTITY libcap-md5
  "0ff11419aa4813c0a0f84fe67bf3b39e">

<!ENTITY libffi-md5
  "96fe46f2a7bb82559b35a268a2c000ba">

<!ENTITY ninja-md5
  "76c00637fde44909cd7d56f8d73f2042">

<!ENTITY pkgconf-md5
  "dd1ba6724bc1792b55600d54346ce5ba">

<!ENTITY meson-md5
